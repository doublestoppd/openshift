# Caddy configuration for the Open Shift Response Portal.
# Install at /etc/caddy/Caddyfile and replace the hostname.
#
# Caddy automatically obtains/renews the TLS certificate for this hostname
# and redirects HTTP (port 80) to HTTPS (port 443).

shifts.example.org {
	encode gzip

	# Django/gunicorn listens on localhost only; Caddy is the sole
	# internet-facing process.
	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=2592000"
		X-Content-Type-Options "nosniff"
	}
}
