# Copy to .env for local development, or install as /etc/openshift-portal/env
# in production (see README). Never commit real values.

# --- Django core ------------------------------------------------------------
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "true" only for local development. Must be "false" (or unset) in production.
DJANGO_DEBUG=false

# Comma-separated hostnames the site is served from.
DJANGO_ALLOWED_HOSTS=shifts.example.org

# Public base URL used to build the invitation links sent by SMS.
PORTAL_BASE_URL=https://shifts.example.org

# Application timezone used for shift dates and expiration.
TIME_ZONE=America/Chicago

# Optional: where the SQLite file lives (defaults to ./db.sqlite3).
#DATABASE_PATH=/srv/openshift-portal/data/db.sqlite3

# Optional: where collectstatic writes files (defaults to ./staticfiles).
#STATIC_ROOT=/srv/openshift-portal/staticfiles

# --- Twilio -----------------------------------------------------------------
# SMS_BACKEND: "twilio" for real sending, "console" to print messages to the
# server log instead (useful for local development).
SMS_BACKEND=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Initial administrator bootstrap (used by create_portal_admin) ----------
# Read by: python manage.py create_portal_admin <username> ... when
# --password-env is not overridden. Remove after first use.
#PORTAL_ADMIN_PASSWORD=

# --- Tuning (optional; defaults shown) ---------------------------------------
# Administrator sign-in lifetime in seconds (12 hours).
#ADMIN_SESSION_AGE=43200
# Staff badge-ID sign-in lifetime in seconds (30 minutes).
#STAFF_SESSION_AGE=1800
# Failed sign-ins allowed per badge ID / username, and per client IP address,
# within the window. Keep the IP limit generous: a whole hospital usually
# shares one public IP.
#LOGIN_RATE_LIMIT_MAX_FAILURES=8
#LOGIN_RATE_LIMIT_IP_MAX_FAILURES=50
#LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
